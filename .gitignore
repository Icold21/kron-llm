# Byte-level and BPE corpora (hundreds of MB, reproducible from scripts/)
data/*.bin
# Generated BPE vocabulary variants (tokenizer4096.json, tokenizer_meta2048.json, ...);
# the shipped data/tokenizer.json stays tracked.
data/tokenizer*.json
data/tokenizer_meta*.json

# Bilingual corpus: raw shards and mixes are large and reproducible from
# scripts/build_bilingual.py.  The manifest, the report and the tokenizer meta
# stay tracked because they are the provenance record.
data/bilingual/shards/
data/bilingual/mix/
data/bilingual/raw/
data/bilingual/*.bin
data/bilingual/tokenizer.json
data/bilingual/tokenizer_sample.txt
data/bilingual/heldout_*.txt
data/bilingual/*.log
# Generated reports (emailed, reproducible from the scripts)
data/bilingual/*email*.md
data/bilingual/identity_report.md
data/bilingual/final_report.md
data/bilingual/identity_audit.json

